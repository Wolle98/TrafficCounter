@* Weekday × hour heatmap as an HTML table; colour (HeatScale) relative to the largest value, with a scale legend.
   The last column holds the row total, without colour, so that it does not take part in the scale.
   Rows can be marked (holidays: a class and tooltip on the row name) and carry footnote numbers (notes).
   With MeasuredMinutes, a value from fewer than 60 measured minutes (extrapolated) gets a "*"; the page explains it. *@
@using System.Globalization

<div class="heatmap-wrap">
    <table class="heatmap">
        <thead>
            <tr>
                <th></th>
                @for (int h = 0; h < 24; h++)
                {
                    <th>@h</th>
                }
                <th>@L["Table.Total"]</th>
            </tr>
        </thead>
        <tbody>
            @for (int d = 0; d < Values.GetLength(0); d++)
            {
                int day = d;
                <tr>
                    <th class="@RowClasses?.ElementAtOrDefault(day)" title="@RowTitles?.ElementAtOrDefault(day)">
                        @RowLabels[day]
                        @foreach (int number in RowFootnotes?.ElementAtOrDefault(day) ?? [])
                        {
                            <a class="footnote-ref" href="#note-@number">@number</a>
                        }
                    </th>
                    @for (int h = 0; h < Values.GetLength(1); h++)
                    {
                        double? value = Values[day, h];
                        if (value is double v)
                        {
                            (string background, string text) = HeatScale.For(v / Math.Max(1, Max));
                            string shown = v.ToString("0", CultureInfo.CurrentCulture);
                            if (MeasuredMinutes?[day, h] is int minutes and < 60)
                            {
                                <td class="partial" style="background:@background;color:@text" title="@L["Heatmap.CellPartial", RowLabels[day], h, h + 1, shown, minutes]">@shown*</td>
                            }
                            else
                            {
                                <td style="background:@background;color:@text" title="@L["Heatmap.Cell", RowLabels[day], h, h + 1, shown]">@shown</td>
                            }
                        }
                        else
                        {
                            <td class="empty" title="@L["Heatmap.NotMeasured"]"></td>
                        }
                    }
                    @{
                        (double? total, int missing) = TrafficStatistics.RowTotal(Values, day);
                    }
                    @if (total is double sum)
                    {
                        <td class="total" title="@(missing > 0 ? L["Heatmap.TotalPartial", missing].Value : null)">@sum.ToString("N0", CultureInfo.CurrentCulture)@(missing > 0 ? "*" : "")</td>
                    }
                    else
                    {
                        <td class="empty" title="@L["Heatmap.NotMeasured"]"></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="heat-legend">
    <span>0</span>
    <i style="background:@HeatScale.Gradient"></i>
    <span>@Max.ToString("0", CultureInfo.CurrentCulture) @L["Heatmap.Unit"]</span>
</div>

@code {
    [Parameter, EditorRequired] public double?[,] Values { get; set; } = new double?[0, 0];

    /// <summary>Row names, by default the weekdays from Monday in the current language.</summary>
    [Parameter] public IReadOnlyList<string> RowLabels { get; set; } = LocalizerExtensions.WeekdaysFromMonday();

    /// <summary>Optional CSS classes of the row names, e.g. "publicholiday".</summary>
    [Parameter] public IReadOnlyList<string?>? RowClasses { get; set; }

    /// <summary>Optional tooltips of the row names.</summary>
    [Parameter] public IReadOnlyList<string?>? RowTitles { get; set; }

    /// <summary>Optional footnote numbers per row, linking to "#note-n".</summary>
    [Parameter] public IReadOnlyList<IReadOnlyList<int>>? RowFootnotes { get; set; }

    /// <summary>Optional measured minutes per cell, same shape as <see cref="Values"/>; below 60 the value gets a "*".</summary>
    [Parameter] public int[,]? MeasuredMinutes { get; set; }

    private double Max => Values.Cast<double?>().Where(v => v is not null).Select(v => v!.Value).DefaultIfEmpty(1).Max();
}
